---
const base = import.meta.env.BASE_URL;
const cafe = `${base}media/cafe/`;
---
<div class="cafe-background" data-cafe-background aria-hidden="true">
  <picture><source media="(max-width: 700px)" srcset={`${cafe}stop-0-mobile.jpg`} /><img src={`${cafe}stop-0-desktop.jpg`} alt="" fetchpriority="high" /></picture>
  <canvas></canvas>
  {[0,1,2,3].map(index => <video data-cafe-clip={index} data-desktop={`${cafe}transition-${String(index+1).padStart(2,'0')}-desktop.mp4`} data-mobile={`${cafe}transition-${String(index+1).padStart(2,'0')}-mobile.mp4`} preload="metadata" muted playsinline tabindex="-1" />)}
</div>
<script>
  import '../scripts/cafe-scroll';
</script>
