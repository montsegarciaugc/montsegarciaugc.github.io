---
import '../styles/global.css';
import VideoCard from './VideoCard.astro';
interface Props { lang: 'es' | 'en' }
const { lang } = Astro.props;
const t = (es: string, en: string) => lang === 'es' ? es : en;
const base = import.meta.env.BASE_URL;
const asset = (name: string) => `${base}media/${name}`;
const localeUrl = (locale: 'es' | 'en') => `${base}${locale === 'en' ? 'en/' : ''}`;
const mail = 'mailto:montsegarciaugc@gmail.com';
const instagram = 'https://www.instagram.com/montsegarcia_ugc/';
const tiktok = 'https://www.tiktok.com/@montsegarcia_ugc';
const projects = [
  {id:'beauty',category:t('Belleza','Beauty'),format:t('Contenido para Ads','Ad content'),video:'perfume-joy',poster:'perfume-poster'},
  {id:'fashion',category:t('Moda','Fashion'),format:t('Reel de moda','Fashion reel'),video:'fashion',poster:'fashion-poster'},
  {id:'food',category:t('Comida','Food'),format:t('Probando comida','Food tasting'),video:'testing-food',poster:'food-poster'},
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t('Portfolio de Montse García. Creadora UGC en Córdoba. Vídeo y fotografía para marcas.','Montse García’s portfolio. UGC creator in Córdoba. Video and photography for brands.')} />
    <meta name="theme-color" content="#f3efe6" />
    <title>{t('Montse García · Portfolio UGC','Montse García · UGC Portfolio')}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={new URL(localeUrl(lang), Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(localeUrl('es'), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(localeUrl('en'), Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">{t('Saltar al contenido','Skip to content')}</a>
    <header class="header">
      <a href="#home" class="wordmark" aria-label={t('Inicio · Montse García','Home · Montse García')}>Montse García</a>
      <nav aria-label={t('Navegación principal','Main navigation')}><a href="#work">{t('Trabajos','Work')}</a><a href="#about">{t('Sobre mí','About')}</a><a href="#contact">{t('Contacto','Contact')}</a></nav>
      <div class="languages" aria-label={t('Idioma','Language')}><a href={localeUrl('es')} lang="es" hreflang="es" data-language aria-current={lang==='es'?'page':undefined}>ES</a><span>/</span><a href={localeUrl('en')} lang="en" hreflang="en" data-language aria-current={lang==='en'?'page':undefined}>EN</a></div>
    </header>
    <main id="main">
      <section id="home" class="home">
        <div class="home-name"><h1>Montse<br /><em>García.</em></h1><p>{t('Creadora UGC · Córdoba','UGC creator · Córdoba')}</p><a class="work-link" href="#work">{t('Ver trabajos','View work')} <span aria-hidden="true">↗</span></a></div>
        <div class="home-photo"><img src={asset('cafe/room-wide.webp')} alt={t('Interior de la cafetería, con mesas y estanterías de madera','Café interior with wooden tables and shelves')} width="2200" height="1650" fetchpriority="high" /></div>
      </section>
      <section id="work" class="work section">
        <h2>{t('Trabajos','Work')}</h2>
        <div class="shelf-scene" style={`--shelf-image:url('${asset('cafe/shelf-texture.webp')}')`}><div class="projects">{projects.map(project=><article id={`project-${project.id}`} class="project"><VideoCard src={asset(`${project.video}.mp4`)} poster={asset(`${project.poster}.webp`)} label={`${project.category} · ${project.format}`} lang={lang} /><div class="project-label"><h3>{project.category}</h3><p>{project.format}</p></div></article>)}</div></div>
      </section>
      <section id="about" class="about section">
        <div class="portrait"><img src={asset('montse-portrait.webp')} alt="Montse García" width="1100" height="1466" loading="lazy" /></div>
        <div class="about-copy"><h2>{t('Sobre mí','About')}</h2><p>{t('Soy Montse, creadora UGC en Córdoba. Hago vídeos y fotografía de belleza, moda y estilo de vida.','I’m Montse, a UGC creator in Córdoba. I make beauty, fashion and lifestyle videos and photography.')}</p><p>{t('También tengo experiencia como consultora de Mary Kay.','I also have experience as a Mary Kay consultant.')}</p><a class="text-link" href={instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a></div>
      </section>
      <section id="services" class="services section">
        <div class="service-photo"><img src={asset('cafe/window.webp')} alt={t('Barra junto a la ventana de la cafetería','Counter beside the café window')} width="2077" height="1165" loading="lazy" /></div>
        <div class="service-copy"><h2>{t('Servicios','Services')}</h2><ul><li>{t('Vídeos UGC para Reels, TikTok y Ads','UGC videos for Reels, TikTok and ads')}</li><li>{t('Fotografía de producto y lifestyle','Product and lifestyle photography')}</li><li>{t('Concepto, grabación y edición','Concept, filming and editing')}</li></ul><a class="text-link" href={mail}>{t('Pedir una propuesta','Request a proposal')} ↗</a></div>
      </section>
      <section id="contact" class="contact">
        <img class="contact-photo" src={asset('cafe/sunset.webp')} alt={t('Córdoba al atardecer','Córdoba at sunset')} width="1731" height="974" loading="lazy" />
        <div class="contact-copy"><h2>{t('Contacto','Contact')}</h2><a class="contact-email" href={mail}>montsegarciaugc@gmail.com</a><div class="social-links"><a href={instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={tiktok} target="_blank" rel="noopener noreferrer">TikTok ↗</a></div></div>
      </section>
    </main>
    <footer><span>© {new Date().getFullYear()} Montse García</span><a href="#home">{t('Volver arriba','Back to top')} ↑</a></footer>
    <script>
      document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach(link => {
        link.addEventListener('click', () => { link.hash = window.location.hash; });
      });
    </script>
  </body>
</html>
