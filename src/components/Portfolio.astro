---
import '../styles/global.css';
import VideoCard from './VideoCard.astro';
import data from '../data/portfolio.json';
import { portfolio, validateContent } from '../lib/content.ts';
validateContent(data);
import '../styles/brand.css';
import { testimonials, equipment } from '../data/portfolio-extras';
import { portraits } from '../data/portraits';
interface Props { lang: 'es' | 'en' }
const { lang } = Astro.props;
const t = (es: string, en: string) => lang === 'es' ? es : en;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const asset = (name: string) => `${base}media/${name}`;
const localeUrl = (locale: 'es' | 'en') => `${base}${locale === 'en' ? 'en/' : ''}`;
const canonical = new URL(localeUrl(lang), Astro.site);
const mail = 'mailto:montsegarciaugc@gmail.com';
const instagram = 'https://www.instagram.com/montsegarcia_ugc/';
const tiktok = 'https://www.tiktok.com/@montsegarcia_ugc';
const niches = portfolio(data, lang);
const photos = [
 {image:'beauty.webp',caption:t('Belleza · Mary Kay','Beauty · Mary Kay')},
 {image:'sample-coffee.webp',caption:t('Bebidas · Café','Drinks · Coffee')},
 {image:'sample-fashion.webp',caption:t('Moda · Detalles','Fashion · Details')},
 {image:'sample-food.webp',caption:t('Bebidas · Café con hielo','Drinks · Iced coffee')},
 {image:'collaboration.webp',caption:t('Hogar · Lifestyle','Home · Lifestyle')},
 {image:'brand.webp',caption:t('Belleza · Producto','Beauty · Product')},
];
const nicheMail = (name: string) => `${mail}?subject=${encodeURIComponent(t('Proyecto UGC · ','UGC project · ')+name)}`;
const sectionOrder = ['niches', ...niches.map(niche => niche.id), 'photos', 'brands', ...(testimonials.length ? ['testimonials'] : []), 'about', ...(equipment.length ? ['equipment'] : []), 'contact'];
// Hero is section 1. Continue alternation through every visible block,
// including the individual sectors, without counting their wrapper twice.
const themeFor = (id: string) => (sectionOrder.indexOf(id) + 2) % 2 === 0 ? 'negative' : 'positive';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={t('Montse García, creadora UGC en Córdoba. Vídeos, fotografía y contenido auténtico para conectar con tu audiencia.','Montse García, UGC creator based in Córdoba, Spain. Authentic videos, photography and social content to connect with your audience.')} />
  <meta name="theme-color" content="#fae6cf" />
  <title>{t('Montse García · Creadora UGC','Montse García · UGC Creator')}</title>
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="es" href={new URL(localeUrl('es'), Astro.site)} />
  <link rel="alternate" hreflang="en" href={new URL(localeUrl('en'), Astro.site)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Allura&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
 </head>
 <body style={`--texture-positive:url('${base}textures/mg-positive.svg');--texture-negative:url('${base}textures/mg-negative.svg')`}>
  <a class="skip" href="#main">{t('Saltar al contenido','Skip to content')}</a>
  <header class="header">
   <a href="#home" class="wordmark" aria-label="Montse García · UGC Creator"><img src={asset('logo-brand-v3.webp')} alt="Montse García · UGC Creator" width="160" height="58" /></a>
   <nav aria-label={t('Navegación principal','Main navigation')}><a href="#niches">{t('Vídeos','Videos')}</a><a href="#photos">{t('Fotos','Photos')}</a><a href="#about">{t('Sobre mí','About')}</a><a href="#contact">{t('Contacto','Contact')}</a></nav>
   <div class="languages" aria-label={t('Seleccionar idioma','Select language')}><a href={localeUrl('es')} lang="es" hreflang="es" data-language aria-current={lang==='es'?'page':undefined}>ES</a><span>/</span><a href={localeUrl('en')} lang="en" hreflang="en" data-language aria-current={lang==='en'?'page':undefined}>EN</a></div>
  </header>
  <main id="main">
   <section id="home" class="hero">
    <div class="hero-set"><img class="studio-background" src={asset(portraits.hero)} alt={t('Montse con su taza de café entre los arcos del estudio','Montse holding her coffee mug between the studio arches')} fetchpriority="high" width="1672" height="941" /><div class="studio-tint" aria-hidden="true"></div></div>
    <div class="hero-copy"><p class="hero-location">UGC Creator · Córdoba</p><h1>Montse<br /><em><span aria-hidden="true">Garc<span class="surname-accent">ı</span>a</span><span class="visually-hidden">García</span></em></h1><a class="round-link" href="#work"><span class="round-arrow" aria-hidden="true">↓</span><span>{t('Ver mi contenido','Explore my work')}</span></a></div>
   </section>
   <section id="niches" class="section sector-index" data-theme={themeFor('niches')} aria-labelledby="sectors-title">
    <div><h2 id="sectors-title">{t('Elige un sector','Choose a sector')} <em>UGC</em></h2><nav class="sector-links" aria-label={t('Nichos de contenido','Content niches')}>{niches.map(niche=><a href={`#${niche.id}`}>{niche.name}<span aria-hidden="true">↗</span></a>)}</nav></div>
    <img class="index-portrait" src={asset(portraits.sectors)} alt={t('Montse con una taza de café','Montse holding a cup of coffee')} width="1100" height="1466" loading="lazy" />
   </section>
   <section id="work" class="work" aria-label={t('Contenido por sectores','Content by sector')}>
    {niches.map(niche=><section id={niche.id} data-theme={themeFor(niche.id)} class:list={['section','sector',{'sector-featured':niche.projects.length > 0,'sector-compact':niche.projects.length === 0}]} aria-labelledby={`title-${niche.id}`}>
     <div class="sector-heading"><h2 id={`title-${niche.id}`}>{niche.name}</h2>{niche.projects.length === 0&&<p>{niche.formats}</p>}</div>
     {niche.projects.length ? <div class="sector-projects">{niche.projects.map(project => <article class="project"><div class="project-label"><h3>{project.title}</h3><p>{project.format}</p></div><VideoCard src={`${base}${project.src}`} poster={project.poster ? `${base}${project.poster}` : undefined} mime={project.mime} label={`${niche.name} · ${project.title}`} lang={lang} /><p class="sample-note">{t('Pieza de muestra','Sample piece')}</p></article>)}</div> : <a class="sector-contact" href={nicheMail(niche.name)}>{t('Crear contenido','Create content')} <span aria-hidden="true">↗</span></a>}
    </section>)}
   </section>
   <section id="photos" class="section photos" data-theme={themeFor('photos')} aria-labelledby="photos-title">
    <h2 id="photos-title">{t('Fotos','Photos')} <em>UGC</em></h2>
    <div class="photo-grid">{photos.map(photo=><figure><button class="image-preview" data-image={asset(photo.image)} data-caption={photo.caption} aria-label={t(`Ampliar imagen: ${photo.caption}`,`Enlarge image: ${photo.caption}`)}><img src={asset(photo.image)} alt={photo.caption} width="600" height="750" loading="lazy" /><span aria-hidden="true">↗</span></button><figcaption>{photo.caption}</figcaption></figure>)}</div>
    <p class="gallery-note">{t('Selección visual del portfolio.','Visual selection from the portfolio.')}</p>
   </section>
   <section id="brands" class="section brands" data-theme={themeFor('brands')} aria-labelledby="brands-title">
    <h2 id="brands-title">{t('Mi experiencia','My experience')} <em>{t('con marcas','with brands')}</em></h2>
    <div class="brand-entry"><span class="brand-name">MARY KAY</span><p>{t('Consultora de belleza y creación de contenido de muestra con sus productos.','Beauty consultant and sample content creation featuring its products.')}</p></div>
   </section>
   {testimonials.length>0&&<section id="testimonials" data-theme={themeFor('testimonials')} class="section testimonials" aria-labelledby="testimonials-title"><h2 id="testimonials-title">{t('La opinión','Feedback')} <em>{t('de mis clientes','from my clients')}</em></h2><div class="testimonial-grid">{testimonials.map(review=><figure><blockquote>{review.quote[lang]}</blockquote><figcaption>{review.author}{review.company&&` · ${review.company}`}</figcaption></figure>)}</div></section>}
   <section id="about" class="section about" data-theme={themeFor('about')} aria-labelledby="about-title">
    <img class="about-portrait" src={asset(portraits.about)} alt={t('Montse García con su taza de café en el estudio','Montse García with her cup of coffee in the studio')} loading="lazy" width="1100" height="1466" />
    <div><h2 id="about-title">{t('Más sobre','More about')} <em>{t('mí','me')}</em></h2><p>{t('Soy Montse García, creadora de contenido UGC en Córdoba. Creo vídeos y fotografías para marcas.','I’m Montse García, a UGC content creator based in Córdoba, Spain. I create videos and photography for brands.')}</p><p>{t('Mi experiencia como consultora de Mary Kay me ha acercado al mundo de la belleza y a la comunicación de producto.','My experience as a Mary Kay consultant has brought me closer to the beauty industry and product communication.')}</p><div class="about-links"><a href={instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={tiktok} target="_blank" rel="noopener noreferrer">TikTok ↗</a></div></div>
   </section>
   {equipment.length>0&&<section id="equipment" data-theme={themeFor('equipment')} class="section equipment" aria-labelledby="equipment-title"><h2 id="equipment-title">{t('Mi material','My recording')} <em>{t('de grabación','equipment')}</em></h2><div class="equipment-grid">{equipment.map(item=><article>{item.image&&<img src={asset(item.image)} alt="" width="400" height="400" loading="lazy" />}<h3>{item.name}</h3><p>{item.description[lang]}</p></article>)}</div></section>}
   <section id="contact" class="section contact" data-theme={themeFor('contact')} aria-labelledby="contact-title">
    <div><h2 id="contact-title">{t('¿Hablamos?','Let’s talk.')} <em>{t('Escríbeme','Get in touch')}</em></h2><address><a class="contact-email" href={mail}>montsegarciaugc@gmail.com <span aria-hidden="true">↗</span></a><a href={instagram} target="_blank" rel="noopener noreferrer">Instagram · @montsegarcia_ugc ↗</a><a href={tiktok} target="_blank" rel="noopener noreferrer">TikTok · @montsegarcia_ugc ↗</a><p>{t('Córdoba, España','Córdoba, Spain')}</p></address></div>
    <img src={asset('contact.webp')} alt={t('Cuaderno rosa con flores secas y un móvil','Pink notebook with dried flowers and a phone')} width="686" height="1036" loading="lazy" />
   </section>
  </main>
  <footer><span>© {new Date().getFullYear()} Montse García</span><a class="developer-credit" href="https://msmc98.github.io" target="_blank" rel="noopener noreferrer">{t('Diseñado y desarrollado por','Designed and developed by')} <strong>mzdev</strong> ↗</a><a href="#niches">{t('Volver a los sectores','Back to sectors')} ↑</a></footer>
  <dialog id="image-dialog" aria-label={t('Vista ampliada de la imagen','Enlarged image view')}><button class="dialog-close" aria-label={t('Cerrar','Close')}>×</button><img alt="" /><p></p></dialog>
<script>
   document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach(link => {
    link.addEventListener('click', () => { link.hash = window.location.hash; });
   });
   const dialog = document.querySelector<HTMLDialogElement>('#image-dialog');
   document.querySelectorAll<HTMLButtonElement>('[data-image]').forEach(button => {
    button.addEventListener('click', () => {
     if (!dialog) return;
     const image = dialog.querySelector('img')!;
     image.src = button.dataset.image!;
     image.alt = button.dataset.caption!;
     dialog.querySelector('p')!.textContent = button.dataset.caption!;
     dialog.showModal();
    });
   });
   dialog?.querySelector('button')?.addEventListener('click', () => dialog.close());
   dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  </script>
 </body>
</html>
